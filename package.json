{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "prebuild": "npm run lint",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "verify:routes": "node --experimental-strip-types scripts/verify-routes.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "15.5.24",
    "react": "19.1.9",
    "react-dom": "19.1.9"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.24",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.9.3",
    "@eslint/eslintrc": "3.3.1"
  },
  "type": "module"
}
